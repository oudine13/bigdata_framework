<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>DATA_ROOT</name>
        <description>Root of the bronze, silver and gold layers</description>
        <default_value>onyxia://${LAB_BUCKET_NAME}</default_value>
      </parameter>
    </parameters>
    <name>gold-orders-by-state-month</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Silver to gold: orders, units and distinct buyers per state and month</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/10/30 15:00:00.000</created_date>
    <modified_date>2026/10/30 15:00:00.000</modified_date>
  </info>
  <transform>
    <type>GetFileNames</type>
    <name>Silver users file</name>
    <file>
      <name>${DATA_ROOT}/silver/hop/</name>
      <filemask>users.*\.parquet</filemask>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <filter>
      <filterfiletype>all_files</filterfiletype>
    </filter>
    <rownum>N</rownum>
    <rownum_field/>
    <filename_Field/>
    <wildcard_Field/>
    <exclude_wildcard_Field/>
    <filefield>N</filefield>
    <dynamic_include_subfolders>N</dynamic_include_subfolders>
    <isaddresult>N</isaddresult>
    <limit>0</limit>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <raiseAnExceptionIfNoFile>N</raiseAnExceptionIfNoFile>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>64</yloc>
    </GUI>
    <description>Silver users written by silver-users.hpl</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ParquetFileInput</type>
    <name>Read silver users</name>
    <filename_field>filename</filename_field>
    <nulls_when_empty>N</nulls_when_empty>
    <fields>
      <field>
        <source_field>user_id</source_field>
        <target_field>user_id</target_field>
        <target_type>String</target_type>
      </field>
      <field>
        <source_field>state</source_field>
        <target_field>state</target_field>
        <target_type>String</target_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>288</xloc>
      <yloc>64</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Keep user columns</name>
    <fields>
      <field>
        <name>user_id</name>
        <rename>user_key</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>state</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>480</xloc>
      <yloc>64</yloc>
    </GUI>
    <description>user_id is renamed: both streams of the join must have distinct field names</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SortRows</type>
    <name>Sort users</name>
    <fields>
      <field>
        <name>user_key</name>
        <ascending>Y</ascending>
        <case_sensitive>Y</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <directory>${java.io.tmpdir}</directory>
    <sort_prefix>out</sort_prefix>
    <sort_size>1000000</sort_size>
    <free_memory/>
    <unique_rows>N</unique_rows>
    <compress>N</compress>
    <compress_variables/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>672</xloc>
      <yloc>64</yloc>
    </GUI>
    <description>Merge Join needs sorted inputs</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>GetFileNames</type>
    <name>Silver orders file</name>
    <file>
      <name>${DATA_ROOT}/silver/hop/</name>
      <filemask>orders.*\.parquet</filemask>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <filter>
      <filterfiletype>all_files</filterfiletype>
    </filter>
    <rownum>N</rownum>
    <rownum_field/>
    <filename_Field/>
    <wildcard_Field/>
    <exclude_wildcard_Field/>
    <filefield>N</filefield>
    <dynamic_include_subfolders>N</dynamic_include_subfolders>
    <isaddresult>N</isaddresult>
    <limit>0</limit>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <raiseAnExceptionIfNoFile>N</raiseAnExceptionIfNoFile>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>192</yloc>
    </GUI>
    <description>Silver orders written by silver-orders.hpl</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ParquetFileInput</type>
    <name>Read silver orders</name>
    <filename_field>filename</filename_field>
    <nulls_when_empty>N</nulls_when_empty>
    <fields>
      <field>
        <source_field>order_id</source_field>
        <target_field>order_id</target_field>
        <target_type>String</target_type>
      </field>
      <field>
        <source_field>user_id</source_field>
        <target_field>user_id</target_field>
        <target_type>String</target_type>
      </field>
      <field>
        <source_field>ordered_at</source_field>
        <target_field>ordered_at</target_field>
        <target_type>Date</target_type>
        <target_format>yyyy-MM-dd HH:mm:ss.SSS</target_format>
      </field>
      <field>
        <source_field>quantity</source_field>
        <target_field>quantity</target_field>
        <target_type>Integer</target_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>288</xloc>
      <yloc>192</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Keep order columns</name>
    <fields>
      <field>
        <name>order_id</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>user_id</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>ordered_at</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>quantity</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>480</xloc>
      <yloc>192</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Calculator</type>
    <name>Add year and month</name>
    <calculation>
      <field_name>year</field_name>
      <calc_type>YEAR_OF_DATE</calc_type>
      <field_a>ordered_at</field_a>
      <field_b/>
      <field_c/>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
      <remove>N</remove>
    </calculation>
    <calculation>
      <field_name>month</field_name>
      <calc_type>MONTH_OF_DATE</calc_type>
      <field_a>ordered_at</field_a>
      <field_b/>
      <field_c/>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
      <remove>N</remove>
    </calculation>
    <failIfNoFile>Y</failIfNoFile>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>672</xloc>
      <yloc>192</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SortRows</type>
    <name>Sort orders</name>
    <fields>
      <field>
        <name>user_id</name>
        <ascending>Y</ascending>
        <case_sensitive>Y</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <directory>${java.io.tmpdir}</directory>
    <sort_prefix>out</sort_prefix>
    <sort_size>1000000</sort_size>
    <free_memory/>
    <unique_rows>N</unique_rows>
    <compress>N</compress>
    <compress_variables/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>864</xloc>
      <yloc>192</yloc>
    </GUI>
    <description>Merge Join needs sorted inputs</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>MergeJoin</type>
    <name>Join orders and users</name>
    <join_type>INNER</join_type>
    <transform1>Sort orders</transform1>
    <transform2>Sort users</transform2>
    <keys_1>
      <key>user_id</key>
    </keys_1>
    <keys_2>
      <key>user_key</key>
    </keys_2>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1056</xloc>
      <yloc>128</yloc>
    </GUI>
    <description>Inner join: an order of an unknown user is dropped</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SortRows</type>
    <name>Sort by group</name>
    <fields>
      <field>
        <name>state</name>
        <ascending>Y</ascending>
        <case_sensitive>Y</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
      <field>
        <name>year</name>
        <ascending>Y</ascending>
        <case_sensitive>Y</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
      <field>
        <name>month</name>
        <ascending>Y</ascending>
        <case_sensitive>Y</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <directory>${java.io.tmpdir}</directory>
    <sort_prefix>out</sort_prefix>
    <sort_size>1000000</sort_size>
    <free_memory/>
    <unique_rows>N</unique_rows>
    <compress>N</compress>
    <compress_variables/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1248</xloc>
      <yloc>128</yloc>
    </GUI>
    <description>Group By needs rows sorted on the group fields</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>GroupBy</type>
    <name>Orders by state and month</name>
    <all_rows>N</all_rows>
    <directory>${java.io.tmpdir}</directory>
    <prefix>grp</prefix>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <group>
      <field>
        <name>state</name>
      </field>
      <field>
        <name>year</name>
      </field>
      <field>
        <name>month</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>orders</aggregate>
        <subject>order_id</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
        <orderfield/>
      </field>
      <field>
        <aggregate>units</aggregate>
        <subject>quantity</subject>
        <type>SUM</type>
        <valuefield/>
        <orderfield/>
      </field>
      <field>
        <aggregate>buyers</aggregate>
        <subject>user_id</subject>
        <type>COUNT_DISTINCT</type>
        <valuefield/>
        <orderfield/>
      </field>
    </fields>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>N</give_back_row>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1440</xloc>
      <yloc>128</yloc>
    </GUI>
    <description>orders, units, distinct buyers</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ParquetFileOutput</type>
    <name>Write gold</name>
    <filename_base>${DATA_ROOT}/gold/hop/orders_by_state_month</filename_base>
    <filename_ext>parquet</filename_ext>
    <filename_include_date>N</filename_include_date>
    <filename_include_time>N</filename_include_time>
    <filename_include_datetime>N</filename_include_datetime>
    <filename_datetime_format>yyyyMMdd-HHmmss</filename_datetime_format>
    <filename_include_copy>N</filename_include_copy>
    <filename_include_split>Y</filename_include_split>
    <filename_split_size>1000000</filename_split_size>
    <filename_create_parent_folders>Y</filename_create_parent_folders>
    <filename_compression_before_extension>N</filename_compression_before_extension>
    <compression_codec>UNCOMPRESSED</compression_codec>
    <version>2.0</version>
    <row_group_size>268435456</row_group_size>
    <data_page_size>8192</data_page_size>
    <dictionary_page_size>1048576</dictionary_page_size>
    <fields>
      <field>
        <source_field>state</source_field>
        <target_field>state</target_field>
      </field>
      <field>
        <source_field>year</source_field>
        <target_field>year</target_field>
      </field>
      <field>
        <source_field>month</source_field>
        <target_field>month</target_field>
      </field>
      <field>
        <source_field>orders</source_field>
        <target_field>orders</target_field>
      </field>
      <field>
        <source_field>units</source_field>
        <target_field>units</target_field>
      </field>
      <field>
        <source_field>buyers</source_field>
        <target_field>buyers</target_field>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1632</xloc>
      <yloc>128</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Silver users file</from>
      <to>Read silver users</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read silver users</from>
      <to>Keep user columns</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Keep user columns</from>
      <to>Sort users</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Silver orders file</from>
      <to>Read silver orders</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read silver orders</from>
      <to>Keep order columns</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Keep order columns</from>
      <to>Add year and month</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Add year and month</from>
      <to>Sort orders</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sort orders</from>
      <to>Join orders and users</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sort users</from>
      <to>Join orders and users</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Join orders and users</from>
      <to>Sort by group</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sort by group</from>
      <to>Orders by state and month</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Orders by state and month</from>
      <to>Write gold</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
